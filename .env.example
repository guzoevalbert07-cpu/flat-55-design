# Ключи только здесь (файл .env в git не попадает). Без ключей сайт собирается, секция фото скрыта.
# Бесплатные стоковые фото (ТЗ §4.5): достаточно одного из двух.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
# Опционально (ТЗ §4, рендеры): не нужен — см. ниже.
# YANDEX_ART_API_KEY=

# Визуализации: основной генератор AI Horde без ключа (scripts/render_views_horde.py); запасной — HF Spaces (scripts/render_views.py), бесплатный HF_TOKEN снимает лимит ZeroGPU
HF_TOKEN=
